{
  "park": {
    "id": "qingfeng",
    "name": "清风园（演示）",
    "hours": "08:00—18:00",
    "source": "MOCK",
    "updatedAt": "2026-10-23T00:00:00Z",
    "verifiedBy": "team"
  },
  "spots": [
    {
      "id": "spot-001",
      "name": "游客中心",
      "narration": "这里是演示游览的起点，省力线、适中线、登高线都从这里出发。服务台旁设有大厅休息椅和饮水处，内部还有卫生间，出发前可以先坐一坐、喝口水。",
      "source": "MOCK",
      "updatedAt": "2026-10-23T00:00:00Z",
      "verifiedBy": "team"
    },
    {
      "id": "spot-002",
      "name": "清风亭",
      "narration": "这座演示亭子设定在树荫下，适合停下来听风、看景。亭内设有座椅，省力线从这里经过，走累了可以在亭里歇一会儿。",
      "source": "MOCK",
      "updatedAt": "2026-10-23T00:00:00Z",
      "verifiedBy": "team"
    },
    {
      "id": "spot-003",
      "name": "荷香池",
      "narration": "演示资料中的池塘种有荷花，可以沿池边慢慢欣赏。池边步道旁设有长椅，池边服务点有卫生间；省力线和适中线都从这里经过。",
      "source": "MOCK",
      "updatedAt": "2026-10-23T00:00:00Z",
      "verifiedBy": "team"
    },
    {
      "id": "spot-004",
      "name": "竹影径",
      "narration": "这条演示步道以竹林为主题，适合放慢脚步听听竹叶声。入口处设有饮水处，步道休息区有竹林休息椅；适中线和登高线都从这里经过。",
      "source": "MOCK",
      "updatedAt": "2026-10-23T00:00:00Z",
      "verifiedBy": "team"
    },
    {
      "id": "spot-005",
      "name": "望山台",
      "narration": "这里是演示观景点，可远眺山景。观景平台旁设有座椅，只有登高线会经过这里，这一段台阶比其他路线多，登高前请先了解自己的体力情况。",
      "source": "MOCK",
      "updatedAt": "2026-10-23T00:00:00Z",
      "verifiedBy": "team"
    },
    {
      "id": "spot-006",
      "name": "东门",
      "narration": "这里设定为清风园的演示出口，三条路线都以这里为终点。出口通道在东门游客通道，离园前请确认随身物品。",
      "source": "MOCK",
      "updatedAt": "2026-10-23T00:00:00Z",
      "verifiedBy": "team"
    }
  ],
