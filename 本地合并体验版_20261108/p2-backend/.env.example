# Copy to .env and replace both values before starting MySQL.
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3308
# Backend only: obtain a Web Service API key from the AMap console.
AMAP_WEB_SERVICE_KEY=
# Agent mode: local defaults to mock; use http for Python HTTP services.
AGENTS_MODE=mock
AGENT_A1_URL=http://127.0.0.1:18001
AGENT_A2_URL=http://127.0.0.1:18002
AGENT_A3_URL=http://127.0.0.1:18003
# Three distinct random values, each at least 16 letters/digits/_/-.
AGENT_A1_API_KEY=
AGENT_A2_API_KEY=
AGENT_A3_API_KEY=
