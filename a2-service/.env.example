# =====================================================================
# A2 领域智能体 v3 —— 环境变量示例（复制为 .env 后按需修改）
# 读取优先级：环境变量 > 本文件 .env > 向上两级 P2 的 .env（借用 AGENT_A2_API_KEY）
# =====================================================================

# ---- 身份与监听 ----
# A2 自己的 API Key（必须 >= 16 位，需与 P2 的 AGENT_A2_API_KEY 一致）
A2_API_KEY=
# 监听地址 / 端口
A2_HOST=127.0.0.1
A2_PORT=18002

# ---- P2 内部回调基地址（A2 调 P2 工具时使用）----
P2_BASE_URL=http://127.0.0.1:8080

# ---- 领域标识（与 P2 调度一致，a2 固定 care 域）----
A2_INTENT=care
A2_DOMAINS=care

# ---- 统一大模型（校内 qwen，免 Key）----
A2_LLM_BASE_URL=http://10.138.50.151:8000
A2_LLM_API_KEY=
A2_LLM_MODEL=qwen3.8-27b
A2_LLM_TIMEOUT=20
# 设为 false 强制走规则兜底（离线 / 调试用）
A2_LLM_ENABLED=true

# ---- 回执持久化（sqlite 文件路径）----
A2_DB_PATH=a2_receipts.db

# ---- system prompt 外部文件（改话术不必动代码）----
A2_SYSTEM_PROMPT_FILE=prompts/system_prompt.txt
