# A1 inbound service (P2 -> A1)
A1_BIND=0.0.0.0
A1_PORT=8093
A1_SERVICE_KEY=replace-with-a-private-random-key

# School model
A1_MODEL_URL=http://replace-model-host:8000/v1/chat/completions
A1_MODEL_NAME=qwen3.8-27b
A1_MODEL_TIMEOUT_SECONDS=40
A1_TOURISM_TIMEOUT_SECONDS=15
A1_FRAUD_WAIT_SECONDS=45

# Domain services called by A1 (loopback defaults are suitable for one machine)
A1_TOURISM_URL=http://127.0.0.1:8091
A1_FRAUD_URL=http://127.0.0.1:8000

# Domain-service listeners; keep loopback for one machine, use 0.0.0.0 for LAN deployment
SERVER_ADDRESS=127.0.0.1
PORT=8091
FRAUD_BIND=127.0.0.1
FRAUD_PORT=8000

# Unified preview; use 0.0.0.0 only when another device needs to open the page
A1_WEB_BIND=127.0.0.1
A1_WEB_PORT=8095

# A1 outbound calls (A1 -> P2; configure when delegation is enabled)
A1_P2_URL=http://replace-p2-host:8080
A1_AGENT_KEY=replace-with-the-key-issued-by-p2-to-a1

# P2 side equivalents (set in the P2 deployment, not necessarily this process)
AGENTS_MODE=http
AGENT_A1_URL=http://replace-a1-host:8093
AGENT_A1_API_KEY=must-equal-A1_SERVICE_KEY
