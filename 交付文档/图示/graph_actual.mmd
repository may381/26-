---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	control(control)
	request(request)
	status(status)
	retry(retry)
	new(new)
	reset(reset)
	planning(planning)
	validation(validation)
	tourism(tourism)
	fraud(fraud)
	__end__([<p>__end__</p>]):::last
	__start__ --> control;
	control -. &nbsp;done&nbsp; .-> __end__;
	control -.-> new;
	control -.-> request;
	control -.-> reset;
	control -.-> retry;
	control -.-> status;
	planning --> validation;
	request -. &nbsp;done&nbsp; .-> __end__;
	request -. &nbsp;plan&nbsp; .-> planning;
	validation -. &nbsp;done&nbsp; .-> __end__;
	validation -.-> fraud;
	validation -.-> tourism;
	fraud --> __end__;
	new --> __end__;
	reset --> __end__;
	retry --> __end__;
	status --> __end__;
	tourism --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
