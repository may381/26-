        "summary": "P01 查询老人档案"
      },
      "patch": {
        "tags": [
          "profile-controller"
        ],
        "operationId": "patch",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "首次建档必须提供全部十项档案字段；已有档案可只传要修改的字段。未传保留，null 拒绝，数组整体替换。id 只读，不能提交。",
                "minProperties": 1,
                "properties": {
                  "nickname": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 0
                  },
                  "age": {
                    "type": "integer",
                    "format": "int32",
                    "maximum": 150,
                    "minimum": 1
                  },
                  "residence": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 0
                  },
                  "language": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 0
                  },
                  "walkSpeed": {
                    "type": "string",
                    "enum": [
                      "SLOW",
                      "MEDIUM",
                      "FAST"
                    ]
                  },
                  "walkDurationMin": {
                    "type": "integer",
                    "format": "int32",
                    "maximum": 1440,
                    "minimum": 1
                  },
                  "avoidSteps": {
                    "type": "boolean"
                  },
                  "interests": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 100,
                      "minLength": 0
                    },
                    "maxItems": 30,
                    "minItems": 0
                  },
                  "interactionPreference": {
                    "type": "string",
                    "enum": [
                      "VOICE",
                      "TEXT"
                    ]
                  },
                  "emergencyContacts": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/cn.silvertravel.platform.profile.ProfileFields.EmergencyContact"
                    },
                    "maxItems": 10,
                    "minItems": 0
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/cn.silvertravel.platform.common.api.ApiResponseCn.silvertravel.platform.profile.ProfileView"
                }
              }
            }
          }
        },
        "summary": "P02 建档或部分更新档案"
      }
    },
