            "description": "字段与前置条件见同目录上级 P2后端接口文档_v1.md。仅在本地测试库执行。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"接口联调演示老人\",\n  \"age\": 68,\n  \"residence\": \"演示城市\",\n  \"language\": \"普通话\",\n  \"walkSpeed\": \"MEDIUM\",\n  \"walkDurationMin\": 60,\n  \"avoidSteps\": true,\n  \"interests\": [\n    \"历史\"\n  ],\n  \"interactionPreference\": \"VOICE\",\n  \"emergencyContacts\": [\n    {\n      \"name\": \"演示联系人\",\n      \"phone\": \"DEMO-NOT-A-PHONE\",\n      \"relation\": \"家属\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('code=OK', () => pm.expect(body.code).to.eql('OK')); ",
                  "pm.test('UUID', () => pm.expect(body.data.id).to.match(/^[0-9a-f-]{36}$/));"
                ]
              }
            }
          ],
          "response": []
        },
