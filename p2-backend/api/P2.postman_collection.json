{
  "info": {
    "name": "银龄智游 P2 本地联调 v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "先阅读 P2后端接口文档_v1.md。默认 userId=u101；00~08 会改演示档案并留下已结束游览/已撤回关系/已解决求助，务必使用测试库。90 含高德和手动上传，不要直接整套运行。无任何真实密钥。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "healthUrl",
      "value": "http://127.0.0.1:8081",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "u101",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "start-from-folder-00",
      "type": "string"
    },
    {
      "key": "familyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "",
      "type": "string"
    },
    {
      "key": "helpId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 启动检查（每轮从这里开始）",
      "item": [
        {
          "name": "开始新一轮：健康 UP（会更新本轮测试 Key）",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{healthUrl}}/actuator/health",
            "description": "字段与前置条件见同目录上级 P2后端接口文档_v1.md。仅在本地测试库执行。"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));",
                  "['familyId','tripId','helpId'].forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('UP', () => pm.expect(body.status).to.eql('UP'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "通用路线：不依赖档案",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Mock-Actor-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-Mock-Actor-Role",
                "value": "ELDER"
              }
            ],
            "url": "{{baseUrl}}/api/routes",
            "description": "字段与前置条件见同目录上级 P2后端接口文档_v1.md。仅在本地测试库执行。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('code=OK', () => pm.expect(body.code).to.eql('OK')); ",
                  "pm.test('3 条演示路线', () => pm.expect(body.data.routes.length).to.eql(3));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
